 "conflicts": [
  {
   "id": "X1",
   "question": "How many GCCs are in India?",
   "facts": [
    "F1",
    "F2",
    "F3",
    "F4",
    "F5",
    "F6"
   ],
   "why": "Mostly definitions and dates. Nasscom-Zinnov counts 2,117 parent companies and 3,728 physical centres in the same report. Brokers count office occupiers. Zinnov's own number jumps from 1,760+ (end-2025) to 2,117 (Mar 2026), which looks like a scope change, not a quarter of growth."
  },
  {
   "id": "X2",
   "question": "How many new GCCs open each year?",
   "facts": [
    "F9",
    "F10",
    "F11",
    "F12",
    "F13"
   ],
   "why": "Research firms land near 100-110 a year. The Finance Minister's 'nearly one a day' is a speech line, not a count."
  },
  {
   "id": "X3",
   "question": "What is GCC attrition?",
   "facts": [
    "F17",
    "F18"
   ],
   "why": "Different samples. EY surveys GCC leaders; Zinnov tracks talent data. Plan for the higher figure in AI and cloud roles."
  },
  {
   "id": "X4",
   "question": "What share of office leasing do GCCs take?",
   "facts": [
    "F19",
    "F20",
    "F21"
   ],
   "why": "Each broker uses its own city set and decides differently whether flex seats used by GCCs count as GCC leasing."
  },
  {
   "id": "X5",
   "question": "How many GCCs are in Bengaluru?",
   "facts": [
    "F33",
    "F34",
    "F35"
   ],
   "why": "487 counts companies; 880+ and 900+ count centres."
  },
  {
   "id": "X6",
   "question": "How many GCCs are in Hyderabad?",
   "facts": [
    "F40",
    "F41",
    "F42"
   ],
   "why": "The state government counts 515; Zinnov counts 355+ centres at end-2025. Different dates and different definitions of a GCC."
  },
  {
   "id": "X7",
   "question": "What does an EOR cost per employee?",
   "facts": [
    "F27",
    "F28"
   ],
   "why": "Both are vendors quoting their own prices. The gap is what an entrant has to negotiate blind."
  },
  {
   "id": "X8",
   "question": "How long does setup take?",
   "facts": [
    "F24",
    "F25",
    "F26"
